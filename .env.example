# Required: AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional
PORT=8080
# Live models supporting input audio transcription (both measured working):
#   gemini-3.1-flash-live-preview               utterance-granular, clean sentences
#   gemini-2.5-flash-native-audio-preview-12-2025  sub-word deltas, lower latency,
#                                               but fragments sentences
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Native-audio Live models reject TEXT output. Only set TEXT for a model known
# to support it.
RESPONSE_MODALITY=AUDIO

# The model generates a spoken reply to everything it hears and a system
# instruction does not stop it. Capping output tokens suppresses generation
# without affecting transcription. Raise only if a model rejects the value.
MAX_OUTPUT_TOKENS=1

# VERBATIM (default) = literal transcription.
# SMART = removes filler words, light grammar cleanup, auto formatting.
# SMART cannot be combined with WORD_TIMESTAMPS or DIARIZATION.
TRANSCRIPTION_MODE=VERBATIM
WORD_TIMESTAMPS=false
DIARIZATION=false

# Comma-separated terms to bias recognition toward (names, product names, jargon)
CUSTOM_VOCABULARY=

# How long to wait for the upstream session to become usable before failing.
CONNECT_TIMEOUT_MS=15000

# On stop, how long to wait for trailing transcription before closing.
STOP_GRACE_MS=3000
