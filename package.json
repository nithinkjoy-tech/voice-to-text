{
  "name": "voice-to-text",
  "version": "0.1.0",
  "description": "Real-time English voice-to-text over WebSocket via Gemini Live API",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "web:build": "esbuild web/app.js --bundle --format=esm --target=es2022 --outfile=web/dist/app.js --minify && cp web/index.html web/pcm-worklet.js web/dist/",
    "cf:dev": "npm run web:build && wrangler dev",
    "cf:deploy": "npm run web:build && wrangler deploy",
    "cf:typecheck": "tsc -p worker/tsconfig.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@google/genai": "^2.19.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260826.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "wrangler": "^4.131.0"
  }
}